# Zahret Al Khaleej WMS - Environment Variables Configuration

# -------------------------------------------------------------
# 1. Client-Side Firebase Configuration (Public)
# -------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zahret-alkhaleej-wms.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zahret-alkhaleej-wms
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zahret-alkhaleej-wms.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Internal Synthetic Email Domain (e.g., username@auth.zahratalkhaleej.local)
NEXT_PUBLIC_INTERNAL_AUTH_DOMAIN=auth.zahratalkhaleej.local

# -------------------------------------------------------------
# 2. Server-Side Firebase Admin Configuration (Confidential - Server Only)
# -------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=zahret-alkhaleej-wms
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@zahret-alkhaleej-wms.iam.gserviceaccount.com
# Replace \n with actual newlines or escaped newlines
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Session Cookie Secret Key / Encryption salt
SESSION_COOKIE_NAME=zak_wms_session
SESSION_COOKIE_MAX_AGE_DAYS=5

# Optional: Firebase Emulator Suite Ports (for testing / offline development)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
